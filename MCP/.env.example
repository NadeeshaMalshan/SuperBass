# Environment variables for MCP Server
# Copy this file to .env and fill in your values

# Backend API URL - URL of the SuperBass backend API
BACKEND_BASE_URL=http://localhost:5000

# MCP Server Port (optional) - Port for the MCP server
# If not set, defaults to 8000
# PORT=8000

# AI Backend URL (Multi-Agent System)
VITE_AI_BACKEND_URL=http://localhost:8001