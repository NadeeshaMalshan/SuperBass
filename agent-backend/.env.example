# SuperBass Agentic Backend Environment Configuration

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# SuperBass MCP Server URL (Model Context Protocol JSON-RPC 2.0)
MCP_SERVER_URL=http://localhost:8000/mcp

# SuperBass Core Backend API URL (ASP.NET Core API)
BACKEND_BASE_URL=http://localhost:5237

# Agent Backend Server Settings
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000","*"]
ENVIRONMENT=development
