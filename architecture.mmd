    classDef aspnet fill:#a8e6cf,stroke:#1a1a2e,stroke-width:2px,rx=12,ry=12;
    classDef postgres fill:#ffd3b6,stroke:#1a1a2e,stroke-width:2px,rx=12,ry=12;
    classDef agentic fill:#fcba03,stroke:#1a1a2e,stroke-width:2px,rx=12,ry=12;
    classDef react fill:#ffaaa5,stroke:#1a1a2e,stroke-width:2px,rx=12,ry=12;
    classDef shared fill:#88d8b0,stroke:#1a1a2e,stroke-width:2px,rx=12,ry=12;
