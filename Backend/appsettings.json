{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID"
    },
    "Jwt": {
      "Secret": "super_secret_key_that_must_be_long_enough_123456789012345"
    }
  },
  "OneSignal": {
    "AppId": "YOUR_ONESIGNAL_APP_ID",
    "RestApiKey": "YOUR_ONESIGNAL_REST_API_KEY"
  }
}